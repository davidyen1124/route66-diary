{
  "name": "route66-diary",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "clean:astro": "rm -rf .astro",
    "dev": "npm run clean:astro && astro dev",
    "build": "npm run clean:astro && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "enrich:map-points": "node scripts/enrich-map-points.mjs",
    "deploy": "npm run build && printf \"_worker.js\\n\" > dist/.assetsignore && npx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^5.17.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "wrangler": "^4.65.0"
  }
}
