---
import BaseHead from "../components/BaseHead.astro";
import Route66ChatBubble from "../components/crow/Route66ChatBubble";
import oregonTrailBg from "../assets/oregon-trail-bg.png";
import type { CrowPageContext } from "../lib/crowContext";

interface Props {
  title: string;
  description: string;
  screenLabel?: string;
  crowContext?: CrowPageContext;
}

const { title, description, screenLabel, crowContext } = Astro.props;
const crowProductId =
  import.meta.env.PUBLIC_CROW_PRODUCT_ID ?? "user_383SB7hko6SfGhyllAKfF71hvW1";
const crowApiUrl = import.meta.env.PUBLIC_CROW_API_URL ?? "https://api.usecrow.org";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <div class="trail-page" style={`--trail-bg: url("${oregonTrailBg.src}");`}>
      <main class="site-shell">
        {screenLabel && <p class="screen-label">{screenLabel}</p>}
        <slot />
      </main>
    </div>
    <Route66ChatBubble
      client:load
      productId={crowProductId}
      apiUrl={crowApiUrl}
      crowContext={crowContext}
    />
  </body>
</html>
