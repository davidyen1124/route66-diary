---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import SnowOverlay from "../components/SnowOverlay.astro";
import ChileRistraOverlay from "../components/ChileRistraOverlay.astro";
import AudioToggleIcon from "../components/AudioToggleIcon";
import SiteShell from "./SiteShell.astro";

type Props = CollectionEntry<"blog">["data"] & {
  audioSrc?: string;
};

const {
  title,
  description,
  pubDate,
  city,
  state,
  location,
  weather,
  youtubeEmbedId,
  audioSrc,
  tags = [],
  mapPoints: frontmatterMapPoints = [],
} = Astro.props as Props;

const showSnow = Array.isArray(tags) && tags.includes("snow");
const showChileRistras =
  Array.isArray(tags) && (tags.includes("chile-ristras") || tags.includes("chili-ristras"));
// David preference: keep this short (no state) in the header meta.
const locationLabel = location || city || state || "Unknown stop";

type MapPoint = { key: string; label: string; lat: number; lng: number };

const PRESET_CITY_POINTS: Record<string, Omit<MapPoint, "key">> = {
  "Los Angeles, CA": { label: "Los Angeles, CA", lat: 34.05224, lng: -118.24368 },
  "Barstow, CA": { label: "Barstow, CA", lat: 34.8958, lng: -117.01728 },
  "Needles, CA": { label: "Needles, CA", lat: 34.84806, lng: -114.61413 },
  "Kingman, AZ": { label: "Kingman, AZ", lat: 35.18944, lng: -114.05301 },
};

const markerByCoords = new Map<string, MapPoint>();
const addPoint = (label: string, lat: number, lng: number) => {
  if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
  const key = `${lat.toFixed(5)},${lng.toFixed(5)}`;
  markerByCoords.set(key, { key, label, lat, lng });
};

if (Array.isArray(frontmatterMapPoints) && frontmatterMapPoints.length > 0) {
  for (const point of frontmatterMapPoints) {
    addPoint(point.label, point.latitude, point.longitude);
  }
}

const placeContext = [city, state].filter(Boolean).join(", ");
if (markerByCoords.size === 0 && placeContext) {
  const preset = PRESET_CITY_POINTS[placeContext];
  if (preset) addPoint(preset.label, preset.lat, preset.lng);
}

const mapPoints = Array.from(markerByCoords.values());
const hasMapLocation = mapPoints.length > 0;
const showMissingMapFallback = !hasMapLocation && Boolean(placeContext);
const mapData = hasMapLocation ? JSON.stringify(mapPoints) : "";

const normalizedYouTubeId = typeof youtubeEmbedId === "string" ? youtubeEmbedId.trim() : "";
const hasYouTubeEmbed = /^[A-Za-z0-9_-]{11}$/.test(normalizedYouTubeId);
const youtubeEmbedUrl = hasYouTubeEmbed
  ? `https://www.youtube-nocookie.com/embed/${normalizedYouTubeId}`
  : "";
---

<SiteShell title={title} description={description}>
  <article class="journal-card entry">
    {showChileRistras && <ChileRistraOverlay />}
    {showSnow && <SnowOverlay />}

    <p class="entry-back-link">
      <a class="entry-back-button" href="/blog/">← Back to blog page</a>
    </p>

    <h1>{title}</h1>

    {audioSrc && (
      <div class="entry-audio-player" data-audio-player aria-label="Audio narration">
        <audio preload="metadata" src={audioSrc} data-audio-el>
          <a href={audioSrc}>Listen to audio narration</a>
        </audio>

        <div class="entry-audio-player__top">
          <button
            class="entry-audio-player__toggle"
            type="button"
            data-audio-toggle
            aria-pressed="false"
            aria-label="Play narration"
          >
            <AudioToggleIcon />
          </button>
          <p class="entry-audio-player__time" data-audio-time>0:00 / --:--</p>
        </div>

        <input
          class="entry-audio-player__seek"
          data-audio-seek
          type="range"
          min="0"
          max="1000"
          step="1"
          value="0"
          aria-label="Seek narration"
        />

        <script is:inline>
          (() => {
            const formatTime = (seconds) => {
              if (!Number.isFinite(seconds)) return "--:--";
              const mins = Math.floor(seconds / 60);
              const secs = Math.floor(seconds % 60)
                .toString()
                .padStart(2, "0");
              return `${mins}:${secs}`;
            };

            const roots = document.querySelectorAll("[data-audio-player]");
            for (const root of roots) {
              const audio = root.querySelector("[data-audio-el]");
              const toggle = root.querySelector("[data-audio-toggle]");
              const seek = root.querySelector("[data-audio-seek]");
              const time = root.querySelector("[data-audio-time]");

              if (
                !(audio instanceof HTMLAudioElement) ||
                !(toggle instanceof HTMLButtonElement) ||
                !(seek instanceof HTMLInputElement) ||
                !(time instanceof HTMLElement)
              ) {
                continue;
              }

              if (audio.preload === "none") {
                audio.preload = "metadata";
              }

              const updateUi = () => {
                const duration = Number.isFinite(audio.duration) ? audio.duration : 0;
                const current = Number.isFinite(audio.currentTime) ? audio.currentTime : 0;
                const progress = duration > 0 ? Math.round((current / duration) * 1000) : 0;
                seek.value = String(progress);
                time.textContent = `${formatTime(current)} / ${formatTime(audio.duration)}`;
                const isPaused = audio.paused;
                toggle.setAttribute("aria-pressed", isPaused ? "false" : "true");
                toggle.setAttribute("aria-label", isPaused ? "Play narration" : "Pause narration");
              };

              toggle.addEventListener("click", () => {
                if (audio.paused) {
                  void audio.play();
                } else {
                  audio.pause();
                }
              });

              seek.addEventListener("input", () => {
                const duration = Number.isFinite(audio.duration) ? audio.duration : 0;
                if (duration <= 0) return;
                const ratio = Number(seek.value) / 1000;
                audio.currentTime = Math.max(0, Math.min(duration, ratio * duration));
              });

              audio.addEventListener("timeupdate", updateUi);
              audio.addEventListener("loadedmetadata", updateUi);
              audio.addEventListener("play", updateUi);
              audio.addEventListener("pause", updateUi);
              audio.addEventListener("ended", updateUi);

              updateUi();
              if (!Number.isFinite(audio.duration) || audio.duration <= 0) {
                audio.load();
              }
            }
          })();
        </script>
      </div>
    )}

    <p class="meta">
      <FormattedDate date={pubDate} />
      <span> · </span>
      <span class="meta-location">{locationLabel}</span>
    </p>

    {weather && <p class="meta">{weather}</p>}

    <div class="prose">
      <slot />
    </div>

    {hasMapLocation ? (
      <section
        id="entry-map"
        class="entry-map"
        aria-label={`Map for ${locationLabel}`}
        data-point-labels={JSON.stringify(mapPoints.map((point) => point.label))}
      >
        <div class="entry-map__frame">
          <div class="entry-map__canvas" data-points={mapData}></div>
        </div>
        <script is:inline>
          (() => {
            const script = document.currentScript;
            const section = script?.closest(".entry-map");
            const root = section?.querySelector(".entry-map__canvas");
            if (!root) return;

            const points = JSON.parse(root.dataset.points || "[]");
            if (!Array.isArray(points) || points.length === 0) return;

            const loadCss = (href) => {
              if (document.querySelector(`link[href="${href}"]`)) return;
              const link = document.createElement("link");
              link.rel = "stylesheet";
              link.href = href;
              document.head.appendChild(link);
            };

            const loadScript = (src) =>
              new Promise((resolve, reject) => {
                if (window.L) return resolve();
                const existing = document.querySelector(`script[src="${src}"]`);
                if (existing) {
                  existing.addEventListener("load", resolve, { once: true });
                  existing.addEventListener("error", reject, { once: true });
                  return;
                }
                const el = document.createElement("script");
                el.src = src;
                el.async = true;
                el.onload = resolve;
                el.onerror = reject;
                document.body.appendChild(el);
              });

            const render = () => {
              const L = window.L;
              if (!L) return;

              const map = L.map(root, {
                scrollWheelZoom: false,
                zoomControl: false,
                attributionControl: false,
              });

              const primaryTile = L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
                maxZoom: 20,
                subdomains: "abcd",
              });
              const fallbackTile = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
              });

              let switchedToFallback = false;
              primaryTile.once("tileerror", () => {
                if (switchedToFallback) return;
                switchedToFallback = true;
                if (map.hasLayer(primaryTile)) map.removeLayer(primaryTile);
                fallbackTile.addTo(map);
              });
              primaryTile.addTo(map);

              const markerByLabel = new Map();
              const markerByNormalizedLabel = new Map();
              const normalizeLabel = (value) =>
                String(value || "")
                  .normalize("NFKD")
                  .replace(/[\u0300-\u036f]/g, "")
                  .toLowerCase()
                  .replace(/&/g, " and ")
                  .replace(/['’]/g, "")
                  .replace(/[^a-z0-9]+/g, " ")
                  .replace(/\s+/g, " ")
                  .trim();

              const markerStrokeColor = "#2f4a3d";
              const bounds = [];
              for (const point of points) {
                const marker = L.circleMarker([point.lat, point.lng], {
                  radius: 8,
                  color: markerStrokeColor,
                  weight: 2,
                  fillColor: "#d78f4f",
                  fillOpacity: 0.95,
                })
                  .addTo(map)
                  .bindPopup(point.label);
                markerByLabel.set(point.label, { marker, point });
                markerByNormalizedLabel.set(normalizeLabel(point.label), { marker, point });
                bounds.push([point.lat, point.lng]);
              }

              let routeLine = null;
              if (bounds.length >= 2) {
                routeLine = L.polyline(bounds, {
                  color: markerStrokeColor,
                  weight: 2,
                  opacity: 0.35,
                  lineJoin: "round",
                  lineCap: "round",
                }).addTo(map);
              }

              const focusMarkerByLabel = (label) => {
                const raw = String(label || "").trim();
                if (!raw) return false;
                const direct = markerByLabel.get(raw);
                const normalized = markerByNormalizedLabel.get(normalizeLabel(raw));
                const match = direct || normalized;
                if (!match) return false;

                const { marker, point } = match;
                map.flyTo([point.lat, point.lng], Math.max(map.getZoom(), 12), {
                  animate: true,
                  duration: 0.85,
                });
                marker.openPopup();
                return true;
              };

              window.focusEntryMapMarkerByLabel = focusMarkerByLabel;
              section.focusMarkerByLabel = focusMarkerByLabel;
              section.dataset.mapReady = "true";
              window.dispatchEvent(
                new CustomEvent("entry-map-ready", {
                  detail: { sectionId: section.id || "entry-map" },
                }),
              );

              if (bounds.length === 1) {
                map.setView(bounds[0], 11);
                return;
              }

              const fitTarget = routeLine ? routeLine.getBounds() : L.latLngBounds(bounds);
              map.fitBounds(fitTarget, { padding: [28, 28] });
            };

            loadCss("https://unpkg.com/leaflet@1.9.4/dist/leaflet.css");
            loadScript("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js").then(render).catch(() => {
              root.innerHTML = '<p style="margin:0;padding:0.75rem;font-size:0.92rem;line-height:1.35;">Map failed to load.</p>';
            });
          })();
        </script>
        <script>
          import { resolveMapPointLabel } from "../lib/mapPointMatcher.js";

          (() => {
            const prose = document.querySelector(".prose");
            const section = document.getElementById("entry-map");
            if (!prose || !section) return;

            let labels = [];
            try {
              const parsed = JSON.parse(section.dataset.pointLabels || "[]");
              labels = Array.isArray(parsed) ? parsed.filter((value) => typeof value === "string") : [];
            } catch {
              labels = [];
            }

            if (labels.length === 0) return;

            const strongNodes = prose.querySelectorAll("strong");
            for (const node of strongNodes) {
              const text = node.textContent?.trim() || "";
              if (!text) continue;

              const resolvedLabel = resolveMapPointLabel(text, labels);
              if (!resolvedLabel) continue;

              node.dataset.mapFocus = "true";
              node.setAttribute("role", "button");
              node.setAttribute("tabindex", "0");
              node.setAttribute("aria-label", `Focus map marker for ${resolvedLabel}`);

              const focus = () => {
                section.scrollIntoView({ behavior: "smooth", block: "start" });

                const tryFocus = () => {
                  if (typeof section.focusMarkerByLabel === "function") return section.focusMarkerByLabel(resolvedLabel);
                  if (typeof window.focusEntryMapMarkerByLabel === "function") {
                    return window.focusEntryMapMarkerByLabel(resolvedLabel);
                  }
                  return false;
                };

                if (tryFocus()) return;

                let attempts = 0;
                const timer = window.setInterval(() => {
                  attempts += 1;
                  if (tryFocus() || attempts >= 30) {
                    window.clearInterval(timer);
                  }
                }, 120);
              };

              node.addEventListener("click", focus);
              node.addEventListener("keydown", (event) => {
                if (event.key !== "Enter" && event.key !== " ") return;
                event.preventDefault();
                focus();
              });
            }
          })();
        </script>
      </section>
      ) : (
        showMissingMapFallback && (
          <section class="entry-map entry-map--fallback" aria-label={`Map for ${locationLabel}`}>
            <p class="entry-map__notice">Map unavailable for this entry right now.</p>
          </section>
        )
      )
    }

    {hasYouTubeEmbed && (
      <section class="entry-video" aria-label="Route 66 soundtrack">
        <div class="entry-video__frame">
          <iframe
            src={youtubeEmbedUrl}
            title="Route 66 soundtrack"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </section>
    )}
  </article>
</SiteShell>

<style>
  .entry {
    width: 100%;
    position: relative;
  }

  .entry-back-link {
    margin: 0 0 var(--space-3);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    letter-spacing: var(--meta-letter-spacing);
    text-transform: uppercase;
    line-height: 1.35;
  }

  .entry-back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.34rem 0.56rem;
    border: 1px solid color-mix(in srgb, var(--border) 78%, #2f2018 22%);
    border-radius: 999px;
    background: rgba(255, 250, 235, 0.82);
    color: var(--pine-soft);
    text-decoration: none;
  }

  .entry-back-button:hover,
  .entry-back-button:focus-visible {
    border-color: color-mix(in srgb, var(--pine-soft) 64%, #1f3329 36%);
    background: rgba(255, 250, 235, 0.94);
    text-decoration: none;
    outline: none;
  }

  .meta {
    margin: 0 0 var(--space-4);
    color: var(--pine-soft);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--meta-letter-spacing);
    line-height: 1.35;
  }

  .entry-audio-player {
    margin: 0 0 var(--space-4);
    padding: 0.85rem 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 80%, #2f2018 20%);
    border-radius: calc(var(--radius-1) + 2px);
    background:
      linear-gradient(135deg, rgba(255, 252, 245, 0.98), rgba(244, 235, 214, 0.92));
    box-shadow:
      inset 0 0 0 1px rgba(255, 252, 242, 0.35),
      0 6px 16px rgba(28, 18, 13, 0.12);
    display: grid;
    gap: var(--space-3);
  }

  .entry-audio-player audio {
    display: none;
  }

  .entry-audio-player__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .entry-audio-player__toggle {
    border: 1px solid color-mix(in srgb, var(--pine) 64%, #1f3329 36%);
    border-radius: 999px;
    background: rgba(46, 70, 58, 0.92);
    color: #fff9ed;
    cursor: pointer;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    box-shadow:
      inset 0 0 0 1px rgba(255, 252, 242, 0.2),
      0 4px 10px rgba(25, 35, 29, 0.2);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background 0.2s ease;
  }

  .entry-audio-player__toggle :global(.entry-audio-player__toggle-icons) {
    width: 1rem;
    height: 1rem;
    display: grid;
    place-items: center;
    position: relative;
  }

  .entry-audio-player__toggle :global(.entry-audio-player__icon) {
    grid-area: 1 / 1;
    width: 1rem;
    height: 1rem;
    transition: opacity 0.12s ease;
  }

  .entry-audio-player__toggle :global(.entry-audio-player__icon--pause) {
    opacity: 0;
  }

  .entry-audio-player__toggle[aria-pressed="true"] :global(.entry-audio-player__icon--play) {
    opacity: 0;
  }

  .entry-audio-player__toggle[aria-pressed="true"] :global(.entry-audio-player__icon--pause) {
    opacity: 1;
  }

  .entry-audio-player__toggle:hover,
  .entry-audio-player__toggle:focus-visible {
    background: rgba(56, 86, 72, 0.98);
    transform: translateY(-1px);
    box-shadow:
      inset 0 0 0 1px rgba(255, 252, 242, 0.28),
      0 6px 14px rgba(25, 35, 29, 0.24);
    outline: none;
  }

  .entry-audio-player__time {
    margin: 0;
    font-family: var(--font-accent);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--pine-soft) 80%, #1f3329 20%);
    line-height: 1.2;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .entry-audio-player__seek {
    width: 100%;
    accent-color: #2f4a3d;
    cursor: pointer;
  }

  .entry-audio-player__seek:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--pine) 50%, #1f3329 50%);
    outline-offset: 2px;
  }

  .entry-audio-player__seek::-webkit-slider-runnable-track {
    height: 0.35rem;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(47, 74, 61, 0.35), rgba(47, 74, 61, 0.15));
  }

  .entry-audio-player__seek::-webkit-slider-thumb {
    appearance: none;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: #2f4a3d;
    border: 2px solid #fff8e7;
    box-shadow: 0 2px 6px rgba(25, 35, 29, 0.25);
    margin-top: -0.3rem;
    transition: transform 0.15s ease;
  }

  .entry-audio-player__seek:active::-webkit-slider-thumb {
    transform: scale(1.08);
  }

  .entry-audio-player__seek::-moz-range-track {
    height: 0.35rem;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(47, 74, 61, 0.35), rgba(47, 74, 61, 0.15));
  }

  .entry-audio-player__seek::-moz-range-thumb {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: #2f4a3d;
    border: 2px solid #fff8e7;
    box-shadow: 0 2px 6px rgba(25, 35, 29, 0.25);
    transition: transform 0.15s ease;
  }

  .entry-audio-player__seek:active::-moz-range-thumb {
    transform: scale(1.08);
  }

  .meta-location {
    font: inherit;
    color: inherit;
    font-weight: 700;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote) {
    margin: 0 0 var(--space-4);
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .prose :global(strong[data-map-focus="true"]) {
    cursor: pointer;
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, var(--pine) 75%, #000 25%);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .prose :global(strong[data-map-focus="true"]:hover),
  .prose :global(strong[data-map-focus="true"]:focus-visible) {
    color: color-mix(in srgb, var(--ink) 86%, #5c2410 14%);
    text-decoration-thickness: 0.11em;
    outline: none;
  }

  .entry-map {
    margin-top: var(--space-5);
  }

  .entry-map__frame {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border) 82%, #2f2018 18%);
    border-radius: var(--radius-1);
    background: rgba(255, 250, 235, 0.75);
    box-shadow: inset 0 0 0 1px rgba(255, 252, 242, 0.35);
  }

  .entry-map__canvas {
    width: 100%;
    height: 14rem;
  }

  .entry-map--fallback {
    padding: 0.75rem 0;
  }

  .entry-video {
    margin-top: var(--space-4);
  }

  .entry-video__frame {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border) 82%, #2f2018 18%);
    border-radius: var(--radius-1);
    background: rgba(255, 250, 235, 0.75);
    box-shadow: inset 0 0 0 1px rgba(255, 252, 242, 0.35);
  }

  .entry-video__frame iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .entry-map__notice {
    margin: 0;
    color: var(--pine-soft);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--meta-letter-spacing);
    line-height: 1.35;
  }

  :global(.leaflet-control-attribution) {
    display: none !important;
  }

  :global(.leaflet-bottom.leaflet-right) {
    display: none !important;
  }

  @media (max-width: 42rem) {
    .entry-audio-player__top {
      flex-direction: row;
    }

    .entry-audio-player__time {
      font-size: 0.7rem;
    }
  }

  @media (min-width: 760px) {
    .entry-map__canvas {
      height: 17rem;
    }
  }
</style>
