---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import SnowOverlay from "../components/SnowOverlay.astro";
import SiteShell from "./SiteShell.astro";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  city,
  state,
  weather,
  tags = [],
  mapPoints: frontmatterMapPoints = [],
} = Astro.props as Props;

const showSnow = Array.isArray(tags) && tags.includes("snow");
const locationLabel = city && state ? `${city}, ${state}` : "Unknown stop";

type MapPoint = { key: string; label: string; lat: number; lng: number };

const PRESET_CITY_POINTS: Record<string, Omit<MapPoint, "key">> = {
  "Los Angeles, CA": { label: "Los Angeles, CA", lat: 34.05224, lng: -118.24368 },
  "Barstow, CA": { label: "Barstow, CA", lat: 34.8958, lng: -117.01728 },
  "Needles, CA": { label: "Needles, CA", lat: 34.84806, lng: -114.61413 },
  "Kingman, AZ": { label: "Kingman, AZ", lat: 35.18944, lng: -114.05301 },
};

const markerByCoords = new Map<string, MapPoint>();
const addPoint = (label: string, lat: number, lng: number) => {
  if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
  const key = `${lat.toFixed(5)},${lng.toFixed(5)}`;
  markerByCoords.set(key, { key, label, lat, lng });
};

if (Array.isArray(frontmatterMapPoints) && frontmatterMapPoints.length > 0) {
  for (const point of frontmatterMapPoints) {
    addPoint(point.label, point.latitude, point.longitude);
  }
}

const placeContext = [city, state].filter(Boolean).join(", ");
if (markerByCoords.size === 0 && placeContext) {
  const preset = PRESET_CITY_POINTS[placeContext];
  if (preset) addPoint(preset.label, preset.lat, preset.lng);
}

const mapPoints = Array.from(markerByCoords.values());
const hasMapLocation = mapPoints.length > 0;
const showMissingMapFallback = !hasMapLocation && Boolean(placeContext);
const mapData = hasMapLocation ? JSON.stringify(mapPoints) : "";
---

<SiteShell title={title} description={description}>
  <article class="journal-card entry">
    {showSnow && <SnowOverlay />}

    <p class="back top-back">
      <a href="/blog">← Back to journal index</a>
    </p>

    <h1>{title}</h1>

    <p class="meta">
      <FormattedDate date={pubDate} />
      <span> · </span>
      <span class="meta-location">{locationLabel}</span>
    </p>

    {weather && <p class="meta">{weather}</p>}

    <div class="prose">
      <slot />
    </div>

    {hasMapLocation ? (
      <section class="entry-map" aria-label={`Map for ${locationLabel}`}>
        <div class="entry-map__frame">
          <div class="entry-map__canvas" data-points={mapData}></div>
        </div>
        <script is:inline>
          (() => {
            const script = document.currentScript;
            const section = script?.closest(".entry-map");
            const root = section?.querySelector(".entry-map__canvas");
            if (!root) return;

            const points = JSON.parse(root.dataset.points || "[]");
            if (!Array.isArray(points) || points.length === 0) return;

            const loadCss = (href) => {
              if (document.querySelector(`link[href="${href}"]`)) return;
              const link = document.createElement("link");
              link.rel = "stylesheet";
              link.href = href;
              document.head.appendChild(link);
            };

            const loadScript = (src) =>
              new Promise((resolve, reject) => {
                if (window.L) return resolve();
                const existing = document.querySelector(`script[src="${src}"]`);
                if (existing) {
                  existing.addEventListener("load", resolve, { once: true });
                  existing.addEventListener("error", reject, { once: true });
                  return;
                }
                const el = document.createElement("script");
                el.src = src;
                el.async = true;
                el.onload = resolve;
                el.onerror = reject;
                document.body.appendChild(el);
              });

            const render = () => {
              const L = window.L;
              if (!L) return;

              const toRad = (deg) => (deg * Math.PI) / 180;
              const haversineMeters = (a, b) => {
                const R = 6371000;
                const dLat = toRad(b[0] - a[0]);
                const dLng = toRad(b[1] - a[1]);
                const lat1 = toRad(a[0]);
                const lat2 = toRad(b[0]);
                const sinDLat = Math.sin(dLat / 2);
                const sinDLng = Math.sin(dLng / 2);
                const h = sinDLat * sinDLat + Math.cos(lat1) * Math.cos(lat2) * sinDLng * sinDLng;
                return 2 * R * Math.asin(Math.min(1, Math.sqrt(h)));
              };

              const mulberry32 = (seed) => {
                let t = seed >>> 0;
                return () => {
                  t += 0x6d2b79f5;
                  let x = Math.imul(t ^ (t >>> 15), 1 | t);
                  x ^= x + Math.imul(x ^ (x >>> 7), 61 | x);
                  return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
                };
              };

              const seedFromPair = (a, b, idx) => {
                const n = (v) => Math.round((v + 180) * 1e6);
                let s = 2166136261;
                const mix = (x) => {
                  s ^= x;
                  s = Math.imul(s, 16777619);
                };
                mix(n(a[0]));
                mix(n(a[1]));
                mix(n(b[0]));
                mix(n(b[1]));
                mix(idx + 1);
                return s >>> 0;
              };

              // Builds a "driving-like" path by inserting gently wiggly intermediate points.
              // Deterministic per segment (no jitter changes between reloads).
              const buildDrivingPath = (latLngs) => {
                if (!Array.isArray(latLngs) || latLngs.length < 2) return latLngs || [];
                const out = [latLngs[0]];
                for (let i = 0; i < latLngs.length - 1; i++) {
                  const a = latLngs[i];
                  const b = latLngs[i + 1];
                  const dist = haversineMeters(a, b);

                  // Short hops look fine as straight segments.
                  if (!Number.isFinite(dist) || dist < 1200) {
                    out.push(b);
                    continue;
                  }

                  // Project to a local-ish meters space (equirectangular) for stable perpendicular offsets.
                  const lat0 = toRad((a[0] + b[0]) / 2);
                  const metersPerDegLat = 111132.92;
                  const metersPerDegLng = Math.max(1e-6, 111412.84 * Math.cos(lat0));
                  const ax = a[1] * metersPerDegLng;
                  const ay = a[0] * metersPerDegLat;
                  const bx = b[1] * metersPerDegLng;
                  const by = b[0] * metersPerDegLat;
                  const dx = bx - ax;
                  const dy = by - ay;
                  const segLen = Math.hypot(dx, dy) || 1;
                  const px = -dy / segLen;
                  const py = dx / segLen;

                  const rand = mulberry32(seedFromPair(a, b, i));
                  const steps = Math.max(6, Math.min(22, Math.round(dist / 18000) + 6));
                  const turns = 1 + Math.floor(rand() * 3); // 1..3
                  const phase = rand() * Math.PI * 2;
                  // Keep it subtle: a few hundred meters on short hops, up to a few km on long legs.
                  const amplitude = Math.min(4000, Math.max(150, dist * (0.015 + rand() * 0.02)));

                  for (let j = 1; j < steps; j++) {
                    const t = j / steps;
                    const baseX = ax + dx * t;
                    const baseY = ay + dy * t;

                    // Ease in/out so endpoints stay anchored at the true points.
                    const ease = Math.sin(Math.PI * t);
                    const wiggle = Math.sin(phase + t * Math.PI * 2 * turns);
                    const micro = (rand() - 0.5) * 0.12;
                    const offset = amplitude * ease * (wiggle + micro);

                    const x = baseX + px * offset;
                    const y = baseY + py * offset;
                    out.push([y / metersPerDegLat, x / metersPerDegLng]);
                  }

                  out.push(b);
                }
                return out;
              };

              const map = L.map(root, {
                scrollWheelZoom: false,
                zoomControl: false,
                attributionControl: false,
              });

              const primaryTile = L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
                maxZoom: 20,
                subdomains: "abcd",
              });
              const fallbackTile = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
              });

              let switchedToFallback = false;
              primaryTile.once("tileerror", () => {
                if (switchedToFallback) return;
                switchedToFallback = true;
                if (map.hasLayer(primaryTile)) map.removeLayer(primaryTile);
                fallbackTile.addTo(map);
              });
              primaryTile.addTo(map);

              const pathLatLngs = buildDrivingPath(points.map((point) => [point.lat, point.lng]));
              if (pathLatLngs.length > 1) {
                L.polyline(pathLatLngs, {
                  color: "#2f4a3d",
                  weight: 3,
                  opacity: 0.85,
                  lineJoin: "round",
                  lineCap: "round",
                  smoothFactor: 1,
                }).addTo(map);
              }

              const bounds = [];
              for (const point of points) {
                L.circleMarker([point.lat, point.lng], {
                  radius: 8,
                  color: "#2f4a3d",
                  weight: 2,
                  fillColor: "#d78f4f",
                  fillOpacity: 0.95,
                })
                  .addTo(map)
                  .bindPopup(point.label);
                bounds.push([point.lat, point.lng]);
              }

              // Ensure the line stays in view even when it's slightly wiggly.
              for (const p of pathLatLngs) bounds.push(p);

              if (bounds.length === 1) {
                map.setView(bounds[0], 11);
                return;
              }

              map.fitBounds(bounds, { padding: [28, 28] });
            };

            loadCss("https://unpkg.com/leaflet@1.9.4/dist/leaflet.css");
            loadScript("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js").then(render).catch(() => {
              root.innerHTML = '<p style="margin:0;padding:0.75rem;font-size:0.92rem;line-height:1.35;">Map failed to load.</p>';
            });
          })();
        </script>
      </section>
      ) : (
        showMissingMapFallback && (
          <section class="entry-map entry-map--fallback" aria-label={`Map for ${locationLabel}`}>
            <p class="entry-map__notice">Map unavailable for this entry right now.</p>
          </section>
        )
      )
    }
  </article>
</SiteShell>

<style>
  .entry {
    width: 100%;
    position: relative;
  }

  .top-back {
    margin: 0 0 var(--space-4);
  }

  .meta {
    margin: 0 0 var(--space-4);
    color: var(--pine-soft);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--meta-letter-spacing);
    line-height: 1.35;
  }

  .meta-location {
    font: inherit;
    color: inherit;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote) {
    margin: 0 0 var(--space-4);
  }

  .entry-map {
    margin-top: var(--space-5);
  }

  .entry-map__frame {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border) 82%, #2f2018 18%);
    border-radius: var(--radius-1);
    background: rgba(255, 250, 235, 0.75);
    box-shadow: inset 0 0 0 1px rgba(255, 252, 242, 0.35);
  }

  .entry-map__canvas {
    width: 100%;
    height: 14rem;
  }

  .entry-map--fallback {
    padding: 0.75rem 0;
  }

  .entry-map__notice {
    margin: 0;
    color: var(--pine-soft);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--meta-letter-spacing);
    line-height: 1.35;
  }

  :global(.leaflet-control-attribution) {
    display: none !important;
  }

  :global(.leaflet-bottom.leaflet-right) {
    display: none !important;
  }

  .back {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
  }

  @media (min-width: 760px) {
    .entry-map__canvas {
      height: 17rem;
    }
  }
</style>
