---
import { SITE_TITLE } from "../consts";
---

<header class="site-header">
  <div class="masthead">
    <div class="masthead__title-wrap">
      <p class="eyebrow">Field Dispatch</p>
      <a href="/blog" class="masthead__title">{SITE_TITLE}</a>
      <p class="masthead__subtitle">The Route 66 Trail Journal</p>
    </div>

    <nav class="masthead__nav" aria-label="Main">
      <a href="/blog">Journal Index</a>
      <a href="/">Start</a>
    </nav>
  </div>

  <p class="masthead__status">Daylight steady. Supplies fair. Wheels moving west.</p>
</header>

<style>
  .masthead {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4);
    color: #f8e9ce;
  }

  .masthead__title-wrap {
    min-width: 0;
  }

  .masthead__title {
    display: inline-block;
    color: #fff3df;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.28rem, 4.3vw, 2rem);
    line-height: 1.06;
    margin-bottom: var(--space-1);
  }

  .masthead__subtitle {
    margin: 0;
    color: #efd8bb;
    font-family: var(--font-accent);
    font-size: 0.48rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .masthead__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .masthead__nav a {
    color: #f9e7c6;
    text-decoration: none;
    border: 1px solid rgba(255, 237, 201, 0.4);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.65rem;
    font-family: var(--font-accent);
    font-size: 0.43rem;
    background: rgba(64, 42, 30, 0.2);
  }

  .masthead__nav a:hover {
    background: rgba(255, 237, 201, 0.15);
  }

  .masthead__status {
    margin: 0;
    border-top: 1px solid rgba(255, 236, 208, 0.2);
    padding: var(--space-2) var(--space-4) var(--space-3);
    font-family: var(--font-accent);
    color: #f1dfc1;
    letter-spacing: 0.04em;
    font-size: 0.43rem;
    text-transform: uppercase;
  }

  @media (max-width: 680px) {
    .masthead {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .masthead__nav {
      justify-content: flex-start;
    }
  }
</style>
