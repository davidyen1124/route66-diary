---
import { SITE_TITLE } from '../consts';
---

<header class="terminal-header">
  <div class="bar">
    <a href="/blog" class="title">{SITE_TITLE.toUpperCase()} :: OREGON TRAIL LOG</a>
    <span class="status">STATUS: ON TRAIL</span>
  </div>
</header>

<style>
  .terminal-header {
    width: min(920px, calc(100% - 1.2rem));
    margin: 0.7rem auto 0;
    border: 2px solid var(--frame);
    background: var(--screen-soft);
    box-shadow: inset 0 0 0 1px rgba(124, 255, 122, 0.08);
  }

  .bar {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.45rem 0.65rem;
  }

  .title {
    color: var(--phosphor);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.86rem;
    letter-spacing: 0.04em;
  }

  .status {
    color: var(--phosphor-dim);
    font-size: 0.74rem;
  }

  @media (min-width: 760px) {
    .bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
