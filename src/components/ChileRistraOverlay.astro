---
const pepperCount = 14;
const peppers = Array.from({ length: pepperCount });
---

<div class="ristra" aria-hidden="true">
  <div class="ristra__strand ristra__strand--left">
    <span class="ristra__cord"></span>
    {peppers.map((_, i) => (
      <span class="ristra__pepper" style={`--i:${i};`}></span>
    ))}
  </div>

  <div class="ristra__strand ristra__strand--right">
    <span class="ristra__cord"></span>
    {peppers.map((_, i) => (
      <span class="ristra__pepper" style={`--i:${i};`}></span>
    ))}
  </div>
</div>

<style>
  .ristra {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 7;
  }

  .ristra__strand {
    position: absolute;
    top: 0;
    height: 100vh;
    width: 1.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    opacity: 0.95;
  }

  .ristra__strand--left {
    left: clamp(0.35rem, 1.3vw, 1.25rem);
  }

  .ristra__strand--right {
    right: clamp(0.35rem, 1.3vw, 1.25rem);
  }

  .ristra__cord {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(to bottom, #4b2f1a, #6c3a1f 20%, #4b2f1a 100%);
    opacity: 0.6;
  }

  .ristra__pepper {
    width: 0.74rem;
    height: 1.1rem;
    border-radius: 58% 58% 68% 68%;
    background: linear-gradient(
      140deg,
      rgba(136, 15, 10, 0.98) 0%,
      rgba(194, 33, 16, 0.98) 45%,
      rgba(95, 10, 7, 0.99) 100%
    );
    box-shadow: 0 1px 0 rgba(20, 5, 3, 0.26);
    position: relative;
  }

  .ristra__pepper:nth-of-type(odd) {
    transform: rotate(-7deg);
  }

  .ristra__pepper:nth-of-type(even) {
    transform: rotate(7deg);
  }

  .ristra__pepper::before {
    content: "";
    position: absolute;
    top: -0.18rem;
    left: 50%;
    width: 0.11rem;
    height: 0.24rem;
    border-radius: 999px;
    background: #355a2f;
    transform: translateX(-50%);
  }

  @media (max-width: 760px) {
    .ristra__strand {
      width: 1.08rem;
    }

    .ristra__pepper {
      width: 0.62rem;
      height: 0.95rem;
    }
  }
</style>
