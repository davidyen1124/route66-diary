---
// Lightweight decorative snow overlay.
// Render conditionally from the post layout based on existing post tags.

const flakeCount = 64;
const flakes = Array.from({ length: flakeCount }, () => {
  const size = (Math.random() * 4.6 + 1.8).toFixed(2);
  const opacity = (Math.random() * 0.3 + 0.55).toFixed(2);
  const xStart = `${(Math.random() * 100).toFixed(3)}%`;
  const xDrift = `${(Math.random() * 28 - 14).toFixed(2)}px`;
  const fallDuration = `${(Math.random() * 7 + 8).toFixed(2)}s`;
  const fallDelay = `${(Math.random() * -16).toFixed(2)}s`;
  const fallDistance = `${Math.round(Math.random() * 60 + 120)}vh`;
  const yStatic = `${(Math.random() * 100).toFixed(2)}%`;

  return {
    size,
    opacity,
    xStart,
    xDrift,
    fallDuration,
    fallDelay,
    fallDistance,
    yStatic,
  };
});
---

<div class="snow" aria-hidden="true">
  <div class="snow__field">
    {flakes.map((f) => (
      <span
        class="snow__flake"
        style={[
          `--flake-size:${f.size}px`,
          `--flake-opacity:${f.opacity}`,
          `--x-start:${f.xStart}`,
          `--x-drift:${f.xDrift}`,
          `--fall-duration:${f.fallDuration}`,
          `--fall-delay:${f.fallDelay}`,
          `--fall-distance:${f.fallDistance}`,
          `--y-static:${f.yStatic}`,
        ].join(';')}
      ></span>
    ))}
  </div>
</div>

<style>
  .snow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    overflow: hidden;
    border-radius: inherit;
    contain: paint;
  }

  .snow__field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }

  .snow__flake {
    position: absolute;
    left: var(--x-start);
    top: -48px;
    width: var(--flake-size);
    height: var(--flake-size);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    opacity: var(--flake-opacity);
    animation: snow-fall var(--fall-duration) linear infinite;
    animation-delay: var(--fall-delay);
    box-shadow: 0 0 2px rgba(255, 255, 255, 0.22);
  }

  @keyframes snow-fall {
    from {
      transform: translate3d(0, -40px, 0);
    }
    50% {
      transform: translate3d(calc(var(--x-drift) * 0.55), calc(var(--fall-distance) * 0.5), 0);
    }
    to {
      transform: translate3d(var(--x-drift), var(--fall-distance), 0);
    }
  }

  @media (max-width: 760px) {
    .snow__flake:nth-child(n + 33) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .snow__flake {
      animation: none;
      top: var(--y-static);
      transform: translate3d(0, 0, 0);
    }
  }
</style>
