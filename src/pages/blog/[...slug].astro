---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BlogNotFound from "../../layouts/BlogNotFound.astro";
import BlogPost from "../../layouts/BlogPost.astro";
import { buildBlogSlugIndex } from "../../lib/blogSlugs";

type BlogEntry = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const slugIndex = buildBlogSlugIndex(allPosts);

  return [...slugIndex.bySlug.values()].map(({ canonical, entry }) => ({
    params: { slug: canonical },
    props: { post: entry, canonical },
  }));
}

const staticPost = (Astro.props.post as BlogEntry | undefined) ?? null;
const staticCanonical = (Astro.props.canonical as string | undefined) ?? null;

const rawSlug = Astro.params.slug;
const slug = Array.isArray(rawSlug) ? rawSlug.join("/") : rawSlug;
const requested = slug ?? "";
let post = staticPost;
let canonical = staticCanonical;

if (!post) {
  const allPosts = await getCollection("blog");
  const slugIndex = buildBlogSlugIndex(allPosts);
  const resolved = slugIndex.bySlug.get(requested);
  post = resolved?.entry ?? null;
  canonical = resolved?.canonical ?? null;
}

if (canonical && requested !== canonical) {
  return Astro.redirect(`/blog/${canonical}/`, 301);
}

if (!post) {
  Astro.response.status = 404;
}

const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
---

{
  post && Content ? (
    <BlogPost
      {...post.data}
      canonicalSlug={canonical ?? undefined}
      audioSrc={canonical ? `/audio/blog/${canonical}.mp3` : undefined}
    >
      <Content />
    </BlogPost>
  ) : (
    <BlogNotFound />
  )
}
