---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

const rawSlug = Astro.params.slug;
const slug = Array.isArray(rawSlug) ? rawSlug.join("/") : rawSlug;
const post = (await getCollection("blog")).find((entry) => entry.id === slug || entry.slug === slug);

if (!post) {
  Astro.response.status = 404;
}

const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
---

{
  post && Content ? (
    <BlogPost {...post.data}>
      <Content />
    </BlogPost>
  ) : (
    <BlogPost
      title="Trail entry not found"
      description="That post could not be located."
      pubDate={new Date()}
    >
      <p>This trail entry does not exist.</p>
      <p>
        <a href="/blog">Return to trail log index</a>
      </p>
    </BlogPost>
  )
}
