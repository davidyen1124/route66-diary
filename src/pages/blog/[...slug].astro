---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { buildBlogSlugIndex } from "../../lib/blogSlugs";

const rawSlug = Astro.params.slug;
const slug = Array.isArray(rawSlug) ? rawSlug.join("/") : rawSlug;

const allPosts = await getCollection("blog");
const slugIndex = buildBlogSlugIndex(allPosts);

const requested = slug ?? "";
const resolved = slugIndex.bySlug.get(requested);

if (resolved && requested !== resolved.canonical) {
  return Astro.redirect(`/blog/${resolved.canonical}/`, 301);
}

const post = resolved?.entry ?? null;

if (!post) {
  Astro.response.status = 404;
}

const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
---

{
  post && Content ? (
    <BlogPost {...post.data}>
      <Content />
    </BlogPost>
  ) : (
    <BlogPost
      title="Trail entry not found"
      description="That post could not be located."
      pubDate={new Date()}
    >
      <p>This trail entry does not exist.</p>
      <p>
        <a href="/blog">Return to trail log index</a>
      </p>
    </BlogPost>
  )
}
