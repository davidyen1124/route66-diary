---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${SITE_TITLE} · Trail Log`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <p class="terminal-label">ROUTE 66 DOS TERMINAL</p>
      <h1>TRAIL LOG INDEX</h1>
      <p class="intro">Select a stop entry to continue.</p>

      <ul class="log-list">
        {
          posts.map((post, i) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <span class="prompt">{`[${String(i + 1).padStart(2, '0')}] >`}</span>
                <span class="title">{post.data.title}</span>
                <span class="date"><FormattedDate date={post.data.pubDate} /></span>
                <span class="desc">{post.data.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>

<style>
  .intro {
    color: var(--phosphor-dim);
    margin-bottom: 0.8rem;
  }

  .log-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .log-list li a {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem;
    border: 1px solid var(--frame);
    background: rgba(18, 28, 18, 0.95);
    padding: 0.55rem;
    color: inherit;
    text-decoration: none;
  }

  .log-list li a:hover {
    border-color: var(--phosphor-dim);
    box-shadow: inset 0 0 0 1px rgba(124, 255, 122, 0.2);
  }

  .prompt {
    color: var(--amber);
    font-size: 0.8rem;
  }

  .title {
    font-weight: 700;
  }

  .date {
    font-size: 0.82rem;
    color: var(--phosphor-dim);
  }

  .desc {
    color: var(--phosphor-dim);
    font-size: 0.88rem;
  }
</style>
