---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import SiteShell from "../../layouts/SiteShell.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const routeStops = [
  { city: "Santa Monica", state: "CA" },
  { city: "Barstow", state: "CA" },
  { city: "Needles", state: "CA" },
  { city: "Kingman", state: "AZ" },
  { city: "Seligman", state: "AZ" },
  { city: "Flagstaff", state: "AZ" },
  { city: "Winslow", state: "AZ" },
  { city: "Holbrook", state: "AZ" },
  { city: "Gallup", state: "NM" },
  { city: "Albuquerque", state: "NM" },
];

const latestPost = posts[0];
const currentStop = latestPost?.data.city && latestPost?.data.state
  ? { city: latestPost.data.city, state: latestPost.data.state }
  : null;
const currentIndex = currentStop
  ? routeStops.findIndex(
      (stop) => stop.city === currentStop.city && stop.state === currentStop.state,
    )
  : -1;

const completedCount = currentIndex >= 0 ? currentIndex + 1 : 0;
const progressPercent = routeStops.length > 0
  ? Math.round((completedCount / routeStops.length) * 100)
  : 0;
const nextStop = currentIndex >= 0 && currentIndex < routeStops.length - 1
  ? routeStops[currentIndex + 1]
  : null;
---

<SiteShell
  title={`${SITE_TITLE} | Trail Journal`}
  description={SITE_DESCRIPTION}
  screenLabel="Route 66 Journal"
>
  <section class="route-progress journal-card" aria-label="Route 66 progress">
    <p class="eyebrow">Route Scope</p>
    <h2 class="route-progress__heading">
      Santa Monica, CA → Albuquerque, NM
    </h2>
    <div class="route-progress__stats">
      <p><strong>Current:</strong> {currentStop ? `${currentStop.city}, ${currentStop.state}` : "Not logged yet"}</p>
      <p><strong>Next:</strong> {nextStop ? `${nextStop.city}, ${nextStop.state}` : "Route complete"}</p>
      <p><strong>Complete:</strong> {progressPercent}%</p>
    </div>
    <ol class="route-timeline" aria-label="Route 66 stop order">
      {
        routeStops.map((stop, index) => {
          const status = currentIndex < 0
            ? "upcoming"
            : index < currentIndex
              ? "completed"
              : index === currentIndex
                ? "current"
                : "upcoming";
          return (
            <li class={`route-timeline__item route-timeline__item--${status}`}>
              <span class="route-timeline__dot" aria-hidden="true" />
              <p class="route-timeline__label">
                {stop.city}, {stop.state}
              </p>
              <span class="route-timeline__status">{status}</span>
            </li>
          );
        })
      }
    </ol>
  </section>

  <ul class="post-list" aria-label="Journal entries">
    {
      posts.map((post) => (
        <li>
          <a class="post-card" href={`/blog/${post.id}/`}>
            <p class="post-card__title">{post.data.title}</p>
            <p class="post-card__meta">
              <FormattedDate date={post.data.pubDate} />
              {post.data.city && post.data.state ? ` · ${post.data.city}, ${post.data.state}` : ""}
            </p>
            <p class="post-card__desc">{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</SiteShell>

<style>
  .route-progress {
    margin: 0 0 var(--space-4);
  }

  .route-progress__heading {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
  }

  .route-progress__stats {
    display: grid;
    gap: var(--space-1);
    margin: 0 0 var(--space-4);
  }

  .route-progress__stats p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .route-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .route-timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem 1fr auto;
    align-items: center;
    gap: var(--space-2);
    min-height: 1.8rem;
    padding-left: var(--space-1);
  }

  .route-timeline__item::before {
    content: "";
    position: absolute;
    left: 0.56rem;
    top: 1rem;
    bottom: -0.9rem;
    width: 2px;
    background: color-mix(in srgb, var(--border) 70%, #2f2018 30%);
  }

  .route-timeline__item:last-child::before {
    content: none;
  }

  .route-timeline__dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--border) 74%, #2f2018 26%);
    background: rgba(255, 249, 233, 0.95);
    z-index: 1;
  }

  .route-timeline__label {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.25;
  }

  .route-timeline__status {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--meta-letter-spacing);
    color: var(--pine-soft);
  }

  .route-timeline__item--completed .route-timeline__dot {
    background: var(--pine);
    border-color: color-mix(in srgb, var(--pine) 72%, #1f3329 28%);
  }

  .route-timeline__item--current .route-timeline__dot {
    background: #d0893f;
    border-color: #9f6128;
  }

  .route-timeline__item--current .route-timeline__label {
    font-weight: 700;
  }

  .route-timeline__item--upcoming .route-timeline__label {
    color: color-mix(in srgb, var(--ink) 84%, #7c6859 16%);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid color-mix(in srgb, var(--border) 82%, #2f2018 18%);
    border-radius: var(--radius-1);
    background: linear-gradient(to bottom, rgba(255, 250, 235, 0.95), rgba(246, 235, 208, 0.95));
    padding: var(--space-4);
  }

  .post-card:hover {
    border-color: color-mix(in srgb, var(--pine-soft) 64%, #1f3329 36%);
  }

  .post-card__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.15;
    color: #2f2018;
  }

  .post-card__meta {
    margin: 0 0 var(--space-2);
    color: var(--pine-soft);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    letter-spacing: var(--meta-letter-spacing);
    text-transform: uppercase;
    line-height: 1.35;
  }

  .post-card__desc {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }
</style>
