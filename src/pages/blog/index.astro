---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import SiteShell from "../../layouts/SiteShell.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const checkpoints = [
  "Santa Monica",
  "Los Angeles",
  "San Bernardino",
  "Kingman",
  "Seligman",
  "Flagstaff",
  "Gallup",
  "Albuquerque",
];

const totalLegs = checkpoints.length - 1;
const completedLegs = Math.min(posts.length, totalLegs);
const progressPercent = Math.round((completedLegs / totalLegs) * 100);
const currentStop =
  checkpoints[Math.min(completedLegs, checkpoints.length - 1)];
const nextStop =
  checkpoints[Math.min(completedLegs + 1, checkpoints.length - 1)];
const hasArrived = completedLegs >= totalLegs;
const currentPosition = hasArrived
  ? `At ${checkpoints[checkpoints.length - 1]}`
  : `Between ${currentStop} and ${nextStop}`;

const meterWidth = 32;
const filledCells = Math.round((progressPercent / 100) * meterWidth);
const asciiMeter = `[${"#".repeat(filledCells)}${".".repeat(meterWidth - filledCells)}]`;
const stopSegments = checkpoints.map((stop, index) => `${index + 1}.${stop}`);
const routeLegendRows = [];
for (let i = 0; i < stopSegments.length; i += 3) {
  routeLegendRows.push(stopSegments.slice(i, i + 3).join(" -> "));
}
const routeLegend = routeLegendRows.join("\n       ");
---

<SiteShell
  title={`${SITE_TITLE} | Trail Log`}
  description={SITE_DESCRIPTION}
  screenLabel="ROUTE 66 EXPEDITION // DAYBOOK INDEX"
>
  <section class="terminal-panel intro-panel">
    <p class="terminal-label">COMMAND</p>
    <h1>TRAIL JOURNAL</h1>
    <p class="intro-copy">Select an entry to continue along the road.</p>
  </section>

  <section class="terminal-panel ascii-panel" aria-label="Trail status chart">
    <p class="terminal-label">TRAIL STATUS</p>
    <div class="trail-dashboard">
      <dl class="status-grid">
        <div>
          <dt>Trail Start</dt>
          <dd>Santa Monica</dd>
        </div>
        <div>
          <dt>Destination</dt>
          <dd>Albuquerque</dd>
        </div>
        <div>
          <dt>Current Position</dt>
          <dd>{currentPosition}</dd>
        </div>
        <div>
          <dt>Next Stop</dt>
          <dd>{hasArrived ? "Camp Established" : nextStop}</dd>
        </div>
      </dl>

      <div class="progress-block" aria-label="Trip progress">
        <p class="progress-meta">Progress {progressPercent}%</p>
        <pre class="progress-meter">{asciiMeter} {progressPercent}%</pre>
      </div>

      <pre class="ascii-chart">LEGS: {completedLegs}/{totalLegs}
ROUTE:
{routeLegend}</pre>
    </div>
  </section>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a class="post-card" href={`/blog/${post.id}/`}>
            <p class="terminal-label">LOG ENTRY</p>
            <p class="post-card__title">{post.data.title}</p>
            <p class="post-card__date">
              <FormattedDate date={post.data.pubDate} />
            </p>
            <p class="post-card__desc">{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</SiteShell>

<style>
  .intro-panel {
    margin-bottom: 0.9rem;
  }

  .intro-copy {
    margin: 0;
    color: var(--crt-dim);
  }

  .ascii-panel {
    margin-bottom: 1rem;
  }

  .trail-dashboard {
    display: grid;
    gap: 0.7rem;
  }

  .status-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 0.7rem;
    border: 1px solid var(--frame-edge);
    background: var(--panel-bg);
    padding: 0.65rem;
  }

  .status-grid div {
    min-width: 0;
  }

  .status-grid dt {
    margin: 0;
    color: var(--crt-dim);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-grid dd {
    margin: 0.25rem 0 0;
    font-size: 0.83rem;
    line-height: 1.5;
  }

  .progress-block {
    border: 1px solid var(--frame-edge);
    background: var(--panel-bg);
    padding: 0.65rem;
  }

  .progress-meta {
    margin: 0 0 0.45rem;
    color: var(--crt-dim);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .progress-meter {
    margin: 0;
    white-space: pre;
    overflow-x: auto;
    color: var(--crt);
  }

  .ascii-chart {
    margin: 0;
    white-space: pre;
    overflow-x: auto;
    background: var(--panel-bg);
    border: 1px solid var(--frame-edge);
    color: var(--crt);
    padding: 0.7rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .post-card {
    display: block;
    border: 1px solid var(--frame-edge);
    background: var(--panel-bg);
    text-decoration: none;
    color: inherit;
    padding: 0.7rem;
    opacity: 0;
    transform: translateY(8px);
    animation: card-enter 260ms ease-out forwards;
  }

  .post-list li:nth-child(1) .post-card {
    animation-delay: 70ms;
  }

  .post-list li:nth-child(2) .post-card {
    animation-delay: 140ms;
  }

  .post-list li:nth-child(3) .post-card {
    animation-delay: 210ms;
  }

  .post-list li:nth-child(n + 4) .post-card {
    animation-delay: 280ms;
  }

  .post-card:hover {
    border-color: var(--crt-dim);
    box-shadow: inset 0 0 0 1px rgba(174, 255, 128, 0.2);
  }

  .post-card__title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
  }

  .post-card__date {
    margin: 0 0 0.35rem;
    color: var(--crt-dim);
    font-size: 0.86rem;
  }

  .post-card__desc {
    margin: 0;
    color: var(--crt-dim);
  }

  @keyframes card-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 620px) {
    .status-grid {
      grid-template-columns: 1fr;
    }

    .progress-meter {
      white-space: pre-wrap;
      overflow-x: visible;
    }

    .ascii-chart {
      white-space: pre-wrap;
      overflow-x: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
