---
import SiteShell from "../layouts/SiteShell.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<SiteShell title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="home-card">
    <p class="home-eyebrow">Route 66 Diary</p>
    <h1>Follow the Road East</h1>
    <p>
      Daily notes, miles logged, and roadside moments from Santa Monica to
      Albuquerque, New Mexico.
    </p>
    <a class="home-cta" href="/blog/">Enter Journal</a>
  </section>
</SiteShell>

<style>
  :global(.trail-page) {
    display: grid;
    place-items: center;
    padding: var(--space-4);
  }

  :global(.trail-page .site-shell) {
    width: min(40rem, 100%);
  }

  .home-card {
    width: 100%;
    margin: 0 auto;
    text-align: center;
    padding: clamp(1.2rem, 3vw, 2rem);
  }

  .home-eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--pine-soft);
    text-transform: uppercase;
    letter-spacing: var(--meta-letter-spacing);
    font-size: var(--text-xs);
  }

  .home-card h1 {
    margin: 0 0 var(--space-3);
  }

  .home-card p {
    margin: 0 0 var(--space-4);
    line-height: 1.5;
  }

  .home-cta {
    display: inline-block;
    text-decoration: none;
    color: #fef6e4;
    background: linear-gradient(to bottom, #456857, #2f4a3d);
    border: 1px solid #274035;
    border-radius: var(--radius-1);
    padding: 0.62rem 0.9rem;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
  }

  .home-cta:hover {
    background: linear-gradient(to bottom, #507564, #355344);
  }
</style>
