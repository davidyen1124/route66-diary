---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latest = posts[0];

const checkpoints = [
  'Santa Monica',
  'Los Angeles',
  'San Bernardino',
  'Kingman',
  'Seligman',
  'Flagstaff',
  'Gallup',
  'Albuquerque',
];

const totalLegs = checkpoints.length - 1;
const completedLegs = Math.min(posts.length, totalLegs);
const progressPercent = Math.max(4, Math.round((completedLegs / totalLegs) * 100));
const currentIndex = Math.min(completedLegs, checkpoints.length - 1);
const currentStop = checkpoints[currentIndex];
const nextStop = checkpoints[Math.min(currentIndex + 1, checkpoints.length - 1)];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="nav-screen">
        <div class="screen-head">
          <p class="mode">ANALOG NAV MODE</p>
          <h1>Route 66 Dashboard</h1>
        </div>

        <div class="gauges">
          <article class="gauge">
            <p class="label">Current</p>
            <p class="reading">{currentStop}</p>
          </article>
          <article class="gauge">
            <p class="label">Next</p>
            <p class="reading">{nextStop}</p>
          </article>
          <article class="gauge">
            <p class="label">Trip %</p>
            <p class="reading">{progressPercent}%</p>
          </article>
        </div>

        <div class="dial-row">
          <div class="dial">
            <div class="needle" style={`transform: rotate(${Math.min(135, -120 + progressPercent * 2.4)}deg)`}></div>
            <p class="dial-label">Progress Needle</p>
          </div>

          <div class="mini-map">
            <div class="map-line">
              <div class="map-fill" style={`width:${progressPercent}%`}></div>
              <div class="map-dot" style={`left:calc(${progressPercent}% - 7px)`}></div>
            </div>
            <div class="map-labels">
              <span>Santa Monica</span>
              <span>Albuquerque</span>
            </div>
          </div>
        </div>

        <div class="dash-footer">
          <p>
            {latest ? (
              <>
                Latest log: <strong>{latest.data.title}</strong> · <FormattedDate date={latest.data.pubDate} />
              </>
            ) : (
              <>No logs yet — ignition pending.</>
            )}
          </p>
          <a href="/blog">Open Stop Log</a>
        </div>

        <div class="hula" aria-label="hula girl dashboard ornament">💃</div>
      </section>

      <section class="panel entries">
        <h2>Recent Entries</h2>
        <ul>
          {posts.map((post, i) => (
            <li>
              <span class="index">#{i + 1}</span>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <small><FormattedDate date={post.data.pubDate} /></small>
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  .nav-screen {
    position: relative;
    border: 4px solid #151515;
    border-radius: 14px;
    background: linear-gradient(180deg, #272a2f, #17191d);
    color: #d9ffb0;
    padding: 0.9rem;
    margin-bottom: 0.85rem;
    box-shadow: inset 0 0 0 2px #3f444f, 0 8px 20px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .screen-head h1 {
    color: #f2f7ff;
    margin-bottom: 0.2rem;
    font-size: 1.35rem;
  }

  .mode {
    margin: 0 0 0.3rem;
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    color: #8de7ff;
    font-weight: 700;
  }

  .gauges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    margin-bottom: 0.7rem;
  }

  .gauge {
    border: 1px solid #444b56;
    background: #101215;
    border-radius: 8px;
    padding: 0.45rem;
  }

  .label {
    margin: 0;
    color: #9bb5d8;
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .reading {
    margin: 0.2rem 0 0;
    color: #f5ff9e;
    font-size: 0.92rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dial-row {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 0.6rem;
  }

  .dial {
    position: relative;
    height: 110px;
    border-radius: 999px 999px 0 0;
    border: 2px solid #4f5663;
    border-bottom: none;
    background: radial-gradient(circle at 50% 100%, #0b0f15, #1b1f29 70%);
    overflow: hidden;
  }

  .needle {
    position: absolute;
    bottom: 8px;
    left: calc(50% - 2px);
    width: 4px;
    height: 78px;
    background: linear-gradient(180deg, #ffd766, #ff8f4f);
    transform-origin: bottom center;
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(255, 170, 90, 0.6);
    transition: transform 0.8s ease;
  }

  .dial-label {
    position: absolute;
    bottom: 6px;
    width: 100%;
    text-align: center;
    margin: 0;
    color: #9ab3d8;
    font-size: 0.72rem;
  }

  .mini-map {
    border: 1px solid #4b5160;
    background: #0f131a;
    border-radius: 8px;
    padding: 0.55rem;
  }

  .map-line {
    position: relative;
    height: 12px;
    border: 1px solid #566074;
    background: #1e2430;
    border-radius: 999px;
    overflow: hidden;
  }

  .map-fill {
    height: 100%;
    background: linear-gradient(90deg, #72d6ff, #4b8dff);
  }

  .map-dot {
    position: absolute;
    top: -3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #9af4ff;
    border: 2px solid #19487f;
    animation: blink 1.2s infinite;
  }

  .map-labels {
    margin-top: 0.35rem;
    display: flex;
    justify-content: space-between;
    color: #8da5c8;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .dash-footer {
    border-top: 1px solid #3b414e;
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .dash-footer p {
    margin: 0;
    color: #d6e4ff;
    font-size: 0.84rem;
  }

  .dash-footer a {
    align-self: flex-start;
    text-decoration: none;
    border: 1px solid #66a4ff;
    color: #9fd0ff;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .hula {
    position: absolute;
    right: 10px;
    bottom: 6px;
    font-size: 1.7rem;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.5));
    transform-origin: bottom center;
    animation: sway 1.5s ease-in-out infinite;
    user-select: none;
  }

  .panel.entries {
    border: 2px solid #9ebfff;
    background: #fff;
    padding: 0.8rem;
  }

  .entries h2 {
    margin-bottom: 0.55rem;
  }

  .entries ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .entries li {
    border: 2px solid #d2e1ff;
    background: #f9fbff;
    padding: 0.45rem 0.5rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.5rem;
    align-items: center;
  }

  .index {
    border: 1px solid #b8cff8;
    border-radius: 999px;
    padding: 0.08rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #35588f;
    background: #ecf3ff;
  }

  .entries a {
    text-decoration: none;
    font-weight: 700;
    color: #123d7a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .entries small {
    color: #4a6ea8;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  @keyframes sway {
    0%, 100% { transform: rotate(-6deg); }
    50% { transform: rotate(8deg); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.65; transform: scale(0.92); }
  }

  @media (min-width: 760px) {
    .dial-row {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .screen-head h1 {
      font-size: 1.65rem;
    }
  }
</style>
